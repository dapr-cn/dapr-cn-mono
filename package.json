{
  "name": "dapr-cn-mono",
  "version": "1.0.0",
  "description": "Management repository for the dapr-cn Chinese Dapr community repositories",
  "private": true,
  "type": "module",
  "scripts": {
    "sync:repos": "node scripts/sync-repos.mjs",
    "sync:repos:test": "node --test scripts/tests/sync-repos.test.mjs",
    "zh:data:check": "node scripts/check-zh-data-workspace.mjs",
    "zh:data:check:test": "node --test scripts/tests/check-zh-data-workspace.test.mjs",
    "zh:data:sync": "tsx scripts/zh-data/sync_source_documents.ts",
    "zh:data:test": "tsx scripts/zh-data/tests/test_sync_source_documents.ts",
    "zh:data:repair": "tsx scripts/zh-data/repair_translation_integrity.ts",
    "source:reset": "node scripts/reset-source-repos.mjs",
    "docs:verify": "tsx scripts/docs-verify/start-local-docs-verification.ts",
    "docs:build": "tsx scripts/docs-verify/start-local-docs-verification.ts --build",
    "docs:verify:test": "tsx scripts/docs-verify/tests/validate-local-docs-verification.ts",
    "version:default:test": "node --test scripts/tests/default-version.test.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "js-yaml": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "packageManager": "pnpm@12.16.1"
}
